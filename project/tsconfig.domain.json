{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "noImplicitAny": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "lib": ["ES2020"],
    "types": [],
    "rootDir": ".",
    "outDir": ".domain-build"
  },
  "include": [
    "assets/scripts/game/domain/**/*.ts",
    "assets/scripts/game/flow/**/*.ts",
    "tests/**/*.ts"
  ]
}
